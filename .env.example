# Public API origin, no trailing slash. Example: https://financial-agent-server.example.workers.dev
# `expo export` (production mode) inlines this into the web bundle.
# Leave it unset for local dev (web: http://localhost:4000, Android emulator: http://10.0.2.2:4000).
# Wrangler vars and secrets are not visible to this static bundle. Set this in CI before export.
EXPO_PUBLIC_API_URL=
