# Web API base. Leave unset or set to / so the bundle calls same-origin /api/*
# (the UI Worker forwards those requests to the API Worker).
# Set an absolute origin only to bypass the proxy and call the API from the browser:
#   EXPO_PUBLIC_API_URL=https://api.example.com
# Trailing slashes are removed. A path, query, or hash is rejected by export:web.
# Native builds show an error screen when this is unset. Local native example:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Local web against the Express server on your machine:
#   EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=
