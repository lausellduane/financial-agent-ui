{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "financial-agent-ui",
  "main": "worker/index.ts",
  // Asset requests do not invoke this script. Only /api/* does.
  // Page views are not Worker invocations and do not use the CPU time limit.
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    {
      "binding": "API",
      "service": "financial-agent-server"
    }
  ],
  // `services` is not inherited by named environments. `wrangler deploy --env poc`
  // forwards /api/* to financial-agent-server-poc instead.
  "env": {
    "poc": {
      "services": [
        {
          "binding": "API",
          "service": "financial-agent-server-poc"
        }
      ]
    }
  }
}
